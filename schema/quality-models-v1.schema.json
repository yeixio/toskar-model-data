{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Models Toskar's quality runs work through",
  "type": "object",
  "required": [
    "schema",
    "chosen",
    "models"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "chosen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "size_bytes",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The model's ID in Toskar"
          },
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "why": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://huggingface\\.co/",
            "description": "One exact file, for a model not in Toskar's catalog"
          },
          "downloads": {
            "type": "integer",
            "minimum": 0,
            "description": "Its Hugging Face downloads when it was checked, to suggest what's popular"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
