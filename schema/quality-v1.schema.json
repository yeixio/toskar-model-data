{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toskar quality results, version 1",
  "type": "object",
  "required": ["schema", "suites", "results"],
  "properties": {
    "schema": {"const": 1},
    "note": {"type": "string"},
    "suites": {"type": "object", "additionalProperties": {"type": "string"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "name", "date", "hardware", "scores"],
        "properties": {
          "model": {"type": "string", "description": "The model's catalog ID, or another name for one the catalog doesn't have"},
          "name": {"type": "string"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "hardware": {"type": "string"},
          "source": {"type": "string", "description": "Where the run can be read"},
          "scores": {
            "type": "object",
            "description": "By suite, a key of suites",
            "additionalProperties": {
              "type": "object",
              "required": ["passed", "of"],
              "properties": {"passed": {"type": "integer", "minimum": 0}, "of": {"type": "integer", "minimum": 1}},
              "additionalProperties": false
            }
          },
          "seconds_per_question": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
