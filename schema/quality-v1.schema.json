{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toskar quality results, version 1",
  "type": "object",
  "required": [
    "schema",
    "suites",
    "results"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "description": "How the results are measured"
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model",
          "name",
          "date",
          "hardware",
          "method_version",
          "scores"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model's catalog ID, or another name for one the catalog doesn't have"
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hardware": {
            "type": "string"
          },
          "method_version": {
            "type": "integer",
            "minimum": 0,
            "description": "The version of how it was measured; 0 is before versions existed"
          },
          "submitted": {
            "type": "boolean",
            "description": "Sent by someone outside the project, and not run by us"
          },
          "source": {
            "type": "string",
            "description": "Where the run can be read"
          },
          "scores": {
            "type": "object",
            "description": "By suite, a key of suites",
            "additionalProperties": {
              "type": "object",
              "required": [
                "passed",
                "of"
              ],
              "properties": {
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "of": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "seconds_per_question": {
            "type": "number",
            "minimum": 0
          },
          "performance": {
            "type": "object",
            "description": "How the model ran on this computer, from a long prompt new each run. Beside the scores and never in them",
            "required": [
              "prompt_tokens",
              "prompt_tokens_per_second",
              "tokens_per_second",
              "first_token_ms",
              "effective_tokens_per_second",
              "gpu_layers",
              "gpu_layers_total"
            ],
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 1,
                "description": "The prompt it was measured with"
              },
              "prompt_tokens_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "How fast it read the prompt"
              },
              "tokens_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "How fast it wrote the answer"
              },
              "first_token_ms": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "From sending to the first token"
              },
              "effective_tokens_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "The answer's tokens over the time from sending to the last one"
              },
              "backend": {
                "type": "string",
                "description": "What it ran on, such as vulkan, metal, cuda, or cpu"
              },
              "gpu_layers": {
                "type": "integer",
                "minimum": 0
              },
              "gpu_layers_total": {
                "type": "integer",
                "minimum": 0
              },
              "gpu_memory_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "context_window": {
                "type": "integer",
                "minimum": 0
              },
              "quantization": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "runs": {
            "enum": [
              "full",
              "partial",
              "cpu",
              "no"
            ],
            "description": "How the model ran on this computer: all on its graphics card or chip; partly, with the rest in system memory; on the processor alone; or not at all, when the row has no scores"
          },
          "why": {
            "type": "string",
            "description": "Why it's short of full, in the runtime's words"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
